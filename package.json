{
  "name": "weabot",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "~1.4.4"
  },
  "scripts": {
    "start": "bun --env-file=.env main.ts",
    "dev": "bun --watch --env-file=.env main.ts",
    "test": "bun test --isolate",
    "test:transport": "bun test --isolate ./tests/public_fetch.integration.ts ./tests/link_open.integration.ts",
    "check": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "bunx bun@1.4.4-canary.20261104.1 lint --max-warnings 0",
    "sandbox:discord": "bun --env-file=.env scripts/sandbox/discord.ts",
    "sandbox:events": "bun --env-file=.env scripts/sandbox/events.ts",
    "sandbox:reactions": "bun --env-file=.env scripts/sandbox/reactions.ts",
    "sandbox:autonomous": "bun --env-file=.env scripts/sandbox/autonomous.ts",
    "eval:reactions": "bun --env-file=.env scripts/eval/reactions.ts"
  },
  "devDependencies": {
    "@types/bun": "~1.4.4"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "arknights-gacha-result-generator": "github:steveny9911/arknights-gacha-result-generator#48ca1f66a8f9d8644a246f16fb8e5ea55960f59f"
  }
}
