{
  "nodeModulesDir": "none",
  "exclude": [
    "node_modules/",
    "test_support/",
    "scripts/migration/",
    "src/utils/retry.test.ts",
    "src/features/poll/poll.test.ts",
    "src/features/stats/embed.test.ts",
    "src/features/reaction_gif.test.ts",
    "src/features/reactions/reactions.test.ts",
    "src/features/chat_context/chat_context.test.ts",
    "src/features/autonomous_chat/turns.test.ts",
    "src/features/autonomous_chat/autonomous_chat.test.ts",
    "src/features/discord_actions/time.test.ts",
    "src/services/discord.test.ts",
    "src/services/discord_events.test.ts",
    "src/services/web_search.test.ts",
    "src/services/reaction_context.test.ts",
    "src/services/usage.test.ts",
    "src/config.test.ts",
    "ai_service.test.ts",
    "ai_service.tools.test.ts"
  ],
  "imports": {
    "@aws-sdk/client-cost-explorer": "npm:@aws-sdk/client-cost-explorer@3.1146.0",
    "@smithy/credential-provider-imds": "npm:@smithy/credential-provider-imds@4.5.2",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "start": "deno run --unstable-cron --unstable-kv --env --allow-net --allow-env main.ts",
    "dev": "deno run --unstable-cron --unstable-kv --env --watch --allow-net --allow-env main.ts",
    "check": "deno check main.ts src/**/*.ts scripts/**/*.ts *.ts",
    "test": "deno test --unstable-kv --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "agent:triage": "deno run --allow-run=gh --allow-env --allow-read --allow-write scripts/issue_agent/triage.ts",
    "agent:stale-close": "deno run --allow-run=gh --allow-env --allow-read --allow-write scripts/issue_agent/stale_close.ts",
    "agent:next-issue": "deno run --allow-run=gh --allow-env --allow-read --allow-write scripts/issue_agent/next_issue.ts",
    "agent:mark-pr-open": "deno run --allow-run=gh --allow-env --allow-read --allow-write scripts/issue_agent/mark_pr_open.ts",
    "agent:run-once": "deno run --allow-run=gh --allow-env --allow-read --allow-write scripts/issue_agent/run_once.ts",
    "test:transport": "deno test --allow-env --allow-net=127.0.0.1,public.example,wrong.example tests/public_fetch.integration.ts tests/link_open.integration.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "always"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
