# Haru secrets. Copy to `.env` and fill in the REQUIRED value:
#
#   cp .env.sample .env
#
# `.env` is read by `bun run start`, `bun run dev`, the sandbox/eval scripts and `docker compose`.
# Restart after editing it. With Docker, use `docker compose up -d --force-recreate`.
#
# Every other setting lives in `config.yaml` (see `config.example.yaml`). Optional secrets are
# commented out; leave one blank or commented to leave it unset.

# REQUIRED. Bot token from the Discord Developer Portal (Bot tab). Use a test bot locally, never the
# production token while production is running. Enable "Message Content Intent" for the bot.
# Run only one instance per token.
DISCORD_TOKEN=

# API key for the provider chosen by ai.provider in config.yaml. For openai, OPENAI_API_KEY also
# works, and for openrouter OPENROUTER_API_KEY. When AI_API_KEY is set it wins, so keep it paired
# with the provider it belongs to.
# Default: unset (AI chat disabled).
# AI_API_KEY=

# Brave Search API key. Default: unset (web search disabled).
# BRAVE_SEARCH_API_KEY=

# Bearer token for the admin HTTP endpoints. Default: unset, so everything except
# GET /health is disabled. Use a long random value, e.g. `openssl rand -hex 32`.
# ADMIN_HTTP_TOKEN=

# OpenAI admin key for \usage cost and token reports (separate from the chat key). Default: unset.
# OPENAI_ADMIN_KEY=
