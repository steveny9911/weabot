# Haru environment sample. Copy to `.env` and fill in the REQUIRED values:
#
#   cp .env.sample .env
#
# `.env` is read by `bun run start`, `bun run dev`, the sandbox/eval scripts and `docker compose`.
# Restart after editing it. With Docker, use `docker compose up -d --force-recreate`.
#
# Optional settings are commented out and show their defaults. Uncomment a line only to change it:
# an uncommented empty value (`TIME_ZONE=`) is an empty string, not the default.
#
# Smallest working setup: the Discord token and a channel ID, plus for AI replies an API key (OpenAI)
# or, for Gemini, the provider, key, model list and persona file from the AI chat section.

# ---------------------------------------------------------------------------
# Discord (REQUIRED)
# ---------------------------------------------------------------------------

# REQUIRED. Bot token from the Discord Developer Portal (Bot tab). Use a test bot locally, never the
# production token while production is running. Enable "Message Content Intent" for the bot.
# Run only one instance per token.
DISCORD_TOKEN=

# REQUIRED: set CHANNEL_ID, CHANNEL_IDS, or both (they are merged).
# Channel for polls, alerts and stats, and where Haru chats.
CHANNEL_ID=
# Comma-separated channel IDs for several servers or channels.
# CHANNEL_IDS=

# ---------------------------------------------------------------------------
# General (optional)
# ---------------------------------------------------------------------------

# Time zone for dates and as the default for Discord events.
# TIME_ZONE=America/Los_Angeles

# Consecutive "glue" days before a wellness alert.
# GLUE_ALERT_THRESHOLD=7

# SQLite database file. Its folder is created if missing. In Docker the folder is /app/data.
# HARU_DB_PATH=./data/haru.sqlite3

# Port for the HTTP server (health check and admin endpoints). Docker publishes no port by default.
# HTTP_PORT=8000

# Bearer token for the admin HTTP endpoints. Default: unset, so everything except
# GET /health is disabled. Use a long random value, e.g. `openssl rand -hex 32`.
# ADMIN_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# AI chat: provider (optional; AI chat is off without AI_API_KEY)
# ---------------------------------------------------------------------------

# Which provider answers chat. One is used at a time: openai or gemini. Default: openai.
# AI_PROVIDER=openai

# API key for the selected provider. For openai, OPENAI_API_KEY also works. When AI_API_KEY is set
# it wins, so keep it paired with the AI_PROVIDER it belongs to. Default: unset (AI chat disabled).
# AI_API_KEY=

# Set to false to turn AI chat off even with a key.
# AI_ENABLED=true

# --- Gemini only (AI_PROVIDER=gemini) ---
# Models, comma-separated and tried in order; the next one is used when a model fails. Put the most
# reliable one first. Startup stops if this or the persona file is missing or empty.
# AI_MODEL=gemini-3.8-flash,gemini-3.7-flash
# File with Haru's persona. With OpenAI the persona is the saved prompt instead.
# AI_SYSTEM_PROMPT_FILE=data/system_prompt.md

# ---------------------------------------------------------------------------
# AI chat: limits and behaviour (optional)
# ---------------------------------------------------------------------------

# Mention requests per user per minute.
# AI_RATE_LIMIT_PER_USER=2

# Soft daily token budget across mentions and autonomous chat.
# AI_DAILY_TOKEN_BUDGET=10000000

# Soft limit on model calls per Pacific day (e.g. a free tier); unset means unlimited. Every model
# attempt counts, including failed ones.
# AI_DAILY_REQUEST_QUOTA=
# Percent of the quota that mentions may use; the rest is headroom.
# AI_DAILY_REQUEST_PERCENT=90

# Maximum characters of user input; 0 means unlimited.
# AI_MAX_INPUT_CHARS=0

# UwU style in replies.
# ENABLE_UWU=true

# Messages of recent conversation sent as context (maximum 100).
# AI_CONTEXT_MAX_MESSAGES=40

# Minutes of silence that start a new conversation context.
# AI_CONTEXT_INACTIVITY_MINUTES=20

# ---------------------------------------------------------------------------
# Web search and links (optional)
# ---------------------------------------------------------------------------

# Brave Search API key. Default: unset (web search disabled).
# BRAVE_SEARCH_API_KEY=

# Default: true when BRAVE_SEARCH_API_KEY is set, otherwise false.
# WEB_SEARCH_ENABLED=true

# Search results added to a reply.
# WEB_SEARCH_MAX_RESULTS=3

# The \open link command.
# LINK_OPEN_ENABLED=true

# ---------------------------------------------------------------------------
# Discord events and invites (optional)
# ---------------------------------------------------------------------------

# Set to false to disable event and invite tools.
# DISCORD_ACTIONS_ENABLED=true

# Comma-separated server IDs where the tools are allowed. Default: empty (every server the bot is in).
# DISCORD_ACTIONS_GUILD_IDS=

# ---------------------------------------------------------------------------
# Autonomous chat (optional; off by default)
# ---------------------------------------------------------------------------

# AUTONOMOUS_CHAT_ENABLED=false

# Comma-separated channel IDs. Default: the CHANNEL_ID/CHANNEL_IDS channels.
# AUTONOMOUS_CHAT_CHANNEL_IDS=

# Chance (0 to 1) that an eligible conversation is considered.
# AUTONOMOUS_CHAT_REPLY_CHANCE=0.35

# Human messages needed, within the activity window, before Haru may join in.
# AUTONOMOUS_CHAT_MIN_HUMAN_MESSAGES=4
# AUTONOMOUS_CHAT_ACTIVITY_WINDOW_MINUTES=20
# Minimum minutes between autonomous replies.
# AUTONOMOUS_CHAT_COOLDOWN_MINUTES=1
# AUTONOMOUS_CHAT_MAX_CONTEXT_MESSAGES=40

# Percent of AI_DAILY_REQUEST_QUOTA below which autonomous chat may run.
# AUTONOMOUS_CHAT_REQUEST_PERCENT=30

# ---------------------------------------------------------------------------
# \usage command (optional; missing values show "Unavailable")
# ---------------------------------------------------------------------------
# With Gemini, \usage shows today's requests and tokens counted by Haru and needs none of these.

# OpenAI admin key for cost and token reports (separate from the chat key). Default: unset.
# OPENAI_ADMIN_KEY=

# Filter OpenAI costs and tokens to one project. Default: unset (whole organization).
# USAGE_OPENAI_PROJECT_ID=
